{
  "name": "@rivus/agent-orchestration",
  "version": "0.0.0",
  "private": true,
  "description": "The agent collaboration control plane: registry, probe, lease, inbox, harness slots, and ACP connection.",
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "development": "./src/acp.ts",
      "import": "./dist/acp.js"
    }
  },
  "files": [
    "dist/",
    "src/**/*.ts",
    "bin/",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "rslib build && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rivus/rslib-config": "workspace:*",
    "@rsbuild/core": "^2.0.3",
    "@rslib/core": "^0.21.3",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^3.25.0"
  }
}
