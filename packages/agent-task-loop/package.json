{
  "name": "@rivus/agent-task-loop",
  "version": "0.12.0",
  "private": false,
  "description": "Run AI coding agents through task execution, review, rework, and pull request handoff.",
  "keywords": [
    "ai-agent",
    "cli",
    "coding-agent",
    "task-runner",
    "workflow"
  ],
  "homepage": "https://github.com/PerfectPan/agent-task-loop#readme",
  "bugs": {
    "url": "https://github.com/PerfectPan/agent-task-loop/issues"
  },
  "license": "GPL-3.0-only",
  "author": "PerfectPan <perfectpan325@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerfectPan/agent-task-loop",
    "directory": "packages/agent-task-loop"
  },
  "bin": {
    "agent-task-loop": "./bin/agent-task-loop.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/rivus-plugin.md",
    "skills/agent-task-loop-cli/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./task-delivery": {
      "types": "./dist/task-delivery.d.ts",
      "import": "./dist/task-delivery.js"
    },
    "./task-management": {
      "types": "./dist/task-management.d.ts",
      "import": "./dist/task-management.js"
    },
    "./rivus-plugin": {
      "types": "./dist/rivus-plugin.d.ts",
      "import": "./dist/rivus-plugin.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "prepack": "vp pack",
    "prepublishOnly": "pnpm test",
    "package:check": "node scripts/check-package.mjs",
    "test": "vp pack && vp test run",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@rivus/agent-kit": "0.11.0",
    "@rivus/agent-kit-collab": "0.11.0",
    "citty": "^0.2.2",
    "effect": "4.0.1",
    "execa": "^10.0.1",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rivus/agent": "0.17.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@rivus/agent": ">=0.17.0 <0.18.0"
  },
  "peerDependenciesMeta": {
    "@rivus/agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  }
