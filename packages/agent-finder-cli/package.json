{
  "name": "@rivus/agent-finder-cli",
  "version": "0.3.0",
  "private": false,
  "description": "Command-line interface for local code agent discovery.",
  "keywords": [
    "ai-agent",
    "cli",
    "coding-agent",
    "discovery",
    "inventory"
  ],
  "homepage": "https://github.com/PerfectPan/agent-task-loop#readme",
  "bugs": {
    "url": "https://github.com/PerfectPan/agent-task-loop/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerfectPan/agent-task-loop",
    "directory": "packages/agent-finder-cli"
  },
  "bin": {
    "agent-finder": "./bin/agent-finder.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --conditions=development src/cli.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test",
    "test": "vp pack && vp test run",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@rivus/agent-kit": "0.11.0",
    "citty": "^0.2.2",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
